{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudePanel",
  "version": "2.0.3",
  "identifier": "app.claudepanel.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClaudePanel",
        "width": 620,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "backgroundColor": "#f5f5f7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBOURGNTE4RjcyOTcwMDEKUldRQmNDbjNHUFdkYWpnMENOWU8raExoQ0VjL1QrK2JzN1NCR1JwT2hlZDZnRFhNd1ZJVUNsT2cK",
      "endpoints": [
        "https://github.com/Nthhh92/ClaudePanel-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "ClaudePanel",
    "shortDescription": "Ouvre Claude, Claude Code et tes skills en un clic",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
