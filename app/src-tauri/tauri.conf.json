{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudePanel",
  "version": "2.0.0",
  "identifier": "app.claudepanel.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClaudePanel",
        "width": 620,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "backgroundColor": "#f5f5f7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "ClaudePanel",
    "shortDescription": "Ouvre Claude, Claude Code et tes skills en un clic",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
