{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudePanel",
  "version": "2.2.5",
  "identifier": "app.claudepanel.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClaudePanel",
        "width": 620,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "backgroundColor": "#f5f5f7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://wttr.in; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDODg4OTRGNUI0OUQxRjIKUldUeTBVbGJUNG1JZlBMU1VtY3BGZG1wUmdyaG5jR2ZYcW9jRTNVVVE0ckF1VUVZcHFiQ3FXK2sK",
      "endpoints": [
        "https://github.com/Nthhh92/ClaudePanel-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "ClaudePanel",
    "shortDescription": "Ouvre Claude, Claude Code et tes skills en un clic",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French", "Spanish", "German", "Italian", "PortugueseBR"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
