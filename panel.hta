<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<title>ClaudePanel</title>
<hta:application id="app" applicationname="ClaudePanel" border="thin" borderstyle="normal"
  caption="yes" maximizebutton="no" minimizebutton="yes" scroll="no" singleinstance="yes"
  innerborder="no" contextmenu="no" sysmenu="yes" icon="panel.ico">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; overflow: hidden; }
  body {
    background: #f5f5f7;
    color: #1d1d1f;
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    cursor: default;
  }

  /* Home */
  .weather {
    position: absolute; top: 22px; right: 26px;
    font-size: 13px; color: #86868b; text-align: right; line-height: 1.4;
  }
  .weather b { display: block; font-size: 22px; font-weight: 300; color: #1d1d1f; }
  .clock {
    position: absolute; top: 22px; left: 26px;
    font-size: 13px; color: #86868b; line-height: 1.4;
  }
  .clock b { display: block; font-size: 22px; font-weight: 300; color: #1d1d1f; }
  .hello { position: absolute; top: 110px; left: 0; right: 0; text-align: center; }
  .hello h1 { font-size: 34px; font-weight: 600; letter-spacing: -0.5px; }
  .hello p { font-size: 15px; color: #86868b; margin-top: 6px; }
  .cards {
    position: absolute; top: 225px; left: 0; right: 0;
    display: flex; justify-content: center;
  }
  .card {
    width: 168px; height: 180px; margin: 0 9px;
    background: #fff; border-radius: 22px;
    box-shadow: 0 2px 14px rgba(0,0,0,0.06);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    cursor: pointer;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .card:hover { transform: translateY(-3px); box-shadow: 0 8px 26px rgba(0,0,0,0.10); }
  .card:active { transform: scale(0.97); }
  .icon {
    position: relative; width: 64px; height: 64px; border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
  }
  .icon.term { background: #1d1d1f; }
  .icon.app { background: #d97757; }
  .icon.skills { background: #5e5ce6; }
  .card span { margin-top: 16px; font-size: 16px; font-weight: 600; }
  .card small { margin-top: 2px; font-size: 12px; color: #86868b; }

  /* Missing or signed-out tool: amber dot on the icon + hint underneath */
  .badge {
    position: absolute; top: -4px; right: -4px; width: 15px; height: 15px; border-radius: 9px;
    background: #e8900a; border: 3px solid #fff; display: none;
  }
  .card.need .badge { display: block; }
  .card.need small { color: #c27a00; }

  /* Skills view */
  #skills {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: #f5f5f7; display: none;
  }
  .bar { position: absolute; top: 18px; left: 20px; right: 24px; height: 36px; }
  .back {
    float: left; width: 36px; height: 36px; border-radius: 18px;
    background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,0.06);
    text-align: center; line-height: 32px; font-size: 22px; cursor: pointer;
  }
  .back:hover { background: #ececf0; }
  .bar h2 { float: left; margin-left: 14px; line-height: 36px; font-size: 22px; font-weight: 600; }
  .state { float: right; line-height: 36px; font-size: 12px; color: #86868b; }
  .search {
    position: absolute; top: 68px; left: 20px; width: calc(100% - 44px); height: 40px;
    border: 0; border-radius: 12px; background: #e9e9ee; padding: 0 16px;
    font-family: inherit; font-size: 14px; color: #1d1d1f; outline: none;
  }
  .search:focus { background: #fff; box-shadow: 0 0 0 3px rgba(94,92,230,0.25); }
  .search::-ms-clear { display: none; }
  .list {
    -ms-overflow-style: -ms-autohiding-scrollbar;
    position: absolute; top: 122px; left: 20px; right: 10px; bottom: 0;
    overflow-y: auto; padding: 0 10px 16px 0;
  }
  .section { font-size: 12px; color: #86868b; text-transform: uppercase; letter-spacing: .5px; margin: 18px 6px 7px; }
  .section:first-child { margin-top: 2px; }
  .box { background: #fff; border-radius: 14px; overflow: hidden; }

  .item + .item { border-top: 1px solid #ececf0; }
  .head { display: flex; align-items: center; padding: 11px 14px; cursor: pointer; }
  .head:hover { background: #fafafc; }
  .chev {
    width: 14px; color: #c7c7cc; font-size: 15px; font-weight: 600;
    transition: transform .2s ease;
  }
  .open .chev { transform: rotate(90deg); color: #5e5ce6; }
  .head .txt { flex: 1; min-width: 0; margin-left: 8px; }
  .head .name { font-size: 14px; font-weight: 600; }
  .head .desc { font-size: 12px; color: #86868b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .open .head .desc { display: none; }
  .count {
    margin-left: 10px; min-width: 24px; padding: 1px 8px; border-radius: 10px;
    background: #f0f0f5; color: #86868b; font-size: 12px; text-align: center;
  }

  .body { display: none; padding: 0 14px 10px 36px; }
  .open .body { display: block; }
  .skill { display: flex; align-items: center; padding: 6px 0; }
  .skill + .skill { border-top: 1px solid #f2f2f5; }
  .skill .sname { flex: 1; min-width: 0; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cmd {
    margin-left: 10px; padding: 3px 9px; border-radius: 7px;
    background: #f0f0f5; font-family: Consolas, monospace; font-size: 11.5px; cursor: pointer; white-space: nowrap;
  }
  .cmd:hover { background: #e4e4f8; color: #5e5ce6; }
  .about { font-size: 12.5px; color: #6e6e73; line-height: 1.45; padding: 2px 0 8px; }
  .chips span {
    display: inline-block; margin: 0 5px 5px 0; padding: 2px 9px; border-radius: 10px;
    background: #f0f0f5; font-size: 11.5px; color: #3a3a3c;
  }
  .foot { padding-top: 6px; text-align: right; }
  .link { font-size: 12px; color: #ff3b30; cursor: pointer; }
  .link:hover { text-decoration: underline; }

  .btn {
    margin-left: 10px; padding: 5px 14px; border-radius: 14px;
    background: #5e5ce6; color: #fff; font-size: 12px; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .btn:hover { background: #4b49d6; }
  .btn.busy { background: #c7c7cc; cursor: default; }
  .empty { text-align: center; color: #86868b; font-size: 13px; padding: 30px 0; }

  /* Unverified skill */
  .warn { vertical-align: -2px; margin-left: 7px; }
  .btn.caution { background: #e8900a; }
  .btn.caution:hover { background: #d1810a; }
  .note {
    display: flex; align-items: flex-start; margin: 2px 0 4px;
    font-size: 12px; color: #9a6b00; line-height: 1.45;
  }
  .note svg { flex: 0 0 auto; margin: 1px 8px 0 0; }

  /* Consent sheet — Apple-style alert */
  .scrim {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 20;
    background: rgba(0,0,0,0.26); display: none;
  }
  .sheet {
    position: absolute; top: 50%; left: 50%; width: 300px;
    transform: translate(-50%, -50%);
    background: #fff; border-radius: 20px; overflow: hidden;
    box-shadow: 0 22px 60px rgba(0,0,0,0.28);
    text-align: center;
    animation: pop .22s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes pop {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.94); }
    to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }
  .sheet .pad { padding: 26px 24px 20px; }
  .sheet .mark {
    width: 54px; height: 54px; margin: 0 auto 15px; border-radius: 27px;
    background: #fff4e0; display: flex; align-items: center; justify-content: center;
  }
  .sheet h3 { font-size: 17px; font-weight: 600; letter-spacing: -0.2px; }
  .sheet p { margin-top: 8px; font-size: 13px; color: #6e6e73; line-height: 1.5; }
  .sheet p b { color: #1d1d1f; font-weight: 600; }
  .sheet .actions { display: flex; border-top: 1px solid #ececf0; }
  .sheet .act { flex: 1; padding: 13px 0; font-size: 16px; cursor: pointer; }
  .sheet .act:hover { background: #fafafc; }
  .sheet .act + .act { border-left: 1px solid #ececf0; }
  .sheet .act.cancel { font-weight: 600; color: #0a84ff; }
  .sheet .act.go { color: #ff3b30; }

  ::selection { background: rgba(94, 92, 230, 0.22); }

  /* Robot */
  #bot {
    position: absolute; z-index: 10; width: 55px; height: 40px; display: none;
    cursor: pointer; transform-origin: 50% 100%;
  }
  #botSprite { width: 55px; height: 40px; }
  .toast {
    position: absolute; bottom: 22px; left: 50%; width: 280px; margin-left: -140px;
    background: rgba(29,29,31,0.9); color: #fff; font-size: 13px; text-align: center;
    padding: 9px 12px; border-radius: 12px; display: none;
  }
</style>
</head>
<body>
  <div id="home">
    <div class="clock" id="clock"><b>--:--</b>&nbsp;</div>
    <div class="weather" id="weather"><b>--°</b>&nbsp;</div>

    <div class="hello">
      <h1 id="greet">Bonjour</h1>
      <p id="subtitle">Que veux-tu ouvrir ?</p>
    </div>

    <div class="cards">
      <div class="card" id="cardCode" onclick="openCode()">
        <div class="icon term">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="5 7 10 12 5 17"></polyline><line x1="13" y1="17" x2="19" y2="17"></line>
          </svg>
          <div class="badge"></div>
        </div>
        <span>Claude Code</span>
        <small id="cardCodeHint">Terminal</small>
      </div>
      <div class="card" id="cardApp" onclick="openApp()">
        <div class="icon app">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round">
            <line x1="12" y1="3" x2="12" y2="21"></line><line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="5.6" y1="5.6" x2="18.4" y2="18.4"></line><line x1="18.4" y1="5.6" x2="5.6" y2="18.4"></line>
          </svg>
          <div class="badge"></div>
        </div>
        <span>Claude</span>
        <small id="cardAppHint">Application</small>
      </div>
      <div class="card" onclick="openSkills()">
        <div class="icon skills">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linejoin="round">
            <rect x="4" y="4" width="6.5" height="6.5" rx="1.8"></rect><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.8"></rect>
            <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.8"></rect><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.8"></rect>
          </svg>
        </div>
        <span>Skills</span>
        <small>Gérer</small>
      </div>
    </div>
  </div>

  <div id="skills">
    <div class="bar">
      <div class="back" onclick="closeSkills()">&#8249;</div>
      <h2>Skills</h2>
      <div class="state" id="state"></div>
    </div>
    <input class="search" id="q" type="text" placeholder="Rechercher…" oninput="onSearch()">
    <div class="list" id="list"></div>
  </div>
  <div class="toast" id="toast"></div>

  <div class="scrim" id="scrim">
    <div class="sheet">
      <div class="pad">
        <div class="mark" id="sheetMark"></div>
        <h3 id="sheetTitle"></h3>
        <p id="sheetMsg"></p>
      </div>
      <div class="actions">
        <div class="act cancel" onclick="closeSheet()">Annuler</div>
        <div class="act go" id="sheetGo" onclick="sheetGo()">Installer quand même</div>
      </div>
    </div>
  </div>

<script src="detect.js"></script>
<script>
  var W = 620, H = 510;
  window.resizeTo(W, H);
  // screen.* is in physical pixels, moveTo in scaled ones
  var dpi = (screen.deviceXDPI || 96) / 96;
  window.moveTo(Math.max(0, (screen.availWidth / dpi - W) / 2), Math.max(0, (screen.availHeight / dpi - H) / 2));

  var shell = new ActiveXObject("WScript.Shell");
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var appDir = fso.GetParentFolderName(decodeURIComponent(location.pathname).replace(/^\//, ""));
  var dataDir = appDir + "\\data";
  var pluginsDir = shell.ExpandEnvironmentStrings("%USERPROFILE%") + "\\.claude\\plugins";

  // Window icon + no maximize button (see seticon.ps1)
  shell.Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + appDir + '\\seticon.ps1"', 0, false);

  // What is installed and signed in. Re-checked every few seconds, so an
  // install finished meanwhile shows up without restarting the panel.
  var env = detectClaude(), codeInstalling = false, appWaiting = false;

  function setCard(id, need, hint) {
    $(id).className = "card" + (need ? " need" : "");
    $(id + "Hint").innerHTML = hint;
  }

  function refreshCards() {
    var was = env;
    env = detectClaude();
    if (env.code && !was.code) { codeInstalling = false; toast("Claude Code est installé ✓"); }
    if (env.app && !was.app) { appWaiting = false; toast("Claude est installé ✓"); }
    setCard("cardCode", !env.code || !env.codeIn,
      env.code ? (env.codeIn ? "Terminal" : "Non connecté · clique ici")
        : codeInstalling ? "Installation en cours…" : "Pas installé · clique ici");
    setCard("cardApp", !env.app || !env.appIn,
      env.app ? (env.appIn ? "Application" : "Non connecté · clique ici")
        : appWaiting ? "En attente d’installation…" : "Pas installé · clique ici");
  }
  refreshCards();
  setInterval(refreshCards, 3000);

  function openCode() {
    if (!env.code) {
      // Anthropic's official installer, in a visible window
      codeInstalling = true;
      shell.Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + appDir + '\\install-code.ps1"', 1, false);
      refreshCards();
      return;
    }
    // Signed out: Claude Code itself asks to log in on start
    shell.CurrentDirectory = shell.ExpandEnvironmentStrings("%USERPROFILE%");
    shell.Run('cmd.exe /k "set "PATH=' + fso.GetParentFolderName(env.code) + ';%PATH%" && claude"', 1, false);
    window.close();
  }

  function openApp() {
    if (!env.app) {
      appWaiting = true;
      shell.Run("https://claude.ai/download", 1, false);
      refreshCards();
      return;
    }
    shell.Run(env.app === "msix" ? 'explorer.exe shell:AppsFolder\\Claude_pzs8sxrjxfjjc!Claude' : '"' + env.app + '"', 1, false);
    window.close();
  }


  function loadWeather() {
    try {
      var xhr = new XMLHttpRequest();
      xhr.open("GET", "https://wttr.in/?format=j1&lang=fr", true);
      xhr.onreadystatechange = function () {
        if (xhr.readyState !== 4 || xhr.status !== 200) return;
        var d = JSON.parse(xhr.responseText);
        var c = d.current_condition[0];
        var desc = c.lang_fr ? c.lang_fr[0].value : c.weatherDesc[0].value;
        var city = d.nearest_area[0].areaName[0].value;
        window.lastTemp = c.temp_C;
        document.getElementById("weather").innerHTML =
          "<b>" + c.temp_C + "°</b>" + desc + "<br>" + city;
      };
      xhr.send();
    } catch (e) {}
  }
  loadWeather();

  function updateClock() {
    var days = ["dimanche", "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi"];
    var months = ["janvier", "février", "mars", "avril", "mai", "juin", "juillet",
      "août", "septembre", "octobre", "novembre", "décembre"];
    var d = new Date(), m = d.getMinutes();
    document.getElementById("clock").innerHTML = "<b>" + d.getHours() + ":" + (m < 10 ? "0" + m : m) + "</b>" +
      days[d.getDay()] + " " + d.getDate() + " " + months[d.getMonth()];
  }
  updateClock();
  setInterval(updateClock, 1000);

  /* ---------- Skills ---------- */

  var installed = [], available = [], catalog = {}, installedIds = {};
  var opened = {}, busy = false, pending = null, confirmId = null;

  function $(id) { return document.getElementById(id); }

  // A skill is "verified" when it ships from a marketplace Anthropic maintains.
  // Anything else — a GitHub repo added by hand — is unverified and warns first.
  var OFFICIAL = { "claude-plugins-official": 1, "anthropic-plugin-directory": 1 };
  function isVerified(mkt) { return !!OFFICIAL[mkt]; }

  // Drawn warning triangle, one stroke, matches the app's Feather-style icons.
  function warnSvg(size) {
    var s = size || 15;
    return '<svg class="warn" width="' + s + '" height="' + s + '" viewBox="0 0 24 24" fill="none" ' +
      'stroke="#e8900a" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>' +
      '<line x1="12" y1="9.5" x2="12" y2="13.5"></line>' +
      '<line x1="12" y1="17" x2="12.01" y2="17"></line></svg>';
  }

  // Consent sheet: a blocking confirm for actions that run third-party code.
  var confirmAction = null;
  function openSheet(title, msg, goLabel, onGo) {
    confirmAction = onGo;
    $("sheetMark").innerHTML = warnSvg(26);
    $("sheetTitle").innerHTML = esc(title);
    $("sheetMsg").innerHTML = msg;
    $("sheetGo").innerHTML = esc(goLabel);
    $("scrim").style.display = "block";
  }
  function closeSheet() { $("scrim").style.display = "none"; confirmAction = null; }
  function sheetGo() { var a = confirmAction; closeSheet(); if (a) a(); }

  function askInstall(id, name) {
    openSheet("Skill non vérifié",
      "<b>" + esc(name) + "</b> ne provient pas d’un marketplace vérifié par Anthropic. " +
      "Son code s’exécutera sur ta machine. En l’installant, tu acceptes d’en assumer les risques.",
      "Installer quand même", function () { install(id); });
  }
  function askAddRepo(repo) {
    openSheet("Dépôt non vérifié",
      "<b>" + esc(repo) + "</b> est un dépôt GitHub tiers, non vérifié par Anthropic. " +
      "Ses plugins s’exécuteront sur ta machine. En l’ajoutant, tu acceptes d’en assumer les risques.",
      "Ajouter quand même", function () { addRepo(repo); });
  }

  function esc(s) {
    return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  function readJson(path) {
    if (!fso.FileExists(path)) return null;
    try {
      var st = new ActiveXObject("ADODB.Stream");
      st.Type = 2; st.Charset = "utf-8"; st.Open(); st.LoadFromFile(path);
      var txt = st.ReadText(); st.Close();
      return JSON.parse(txt);
    } catch (e) { return null; }
  }

  function loadData() {
    installed = readJson(dataDir + "\\installed.json") || [];
    var av = readJson(dataDir + "\\available.json");
    if (av && av.available) available = av.available;
    var cat = readJson(pluginsDir + "\\plugin-catalog-cache.json");
    if (cat && cat.catalog) catalog = cat.catalog.plugins || {};
    installedIds = {};
    for (var i = 0; i < installed.length; i++) installedIds[installed[i].id] = true;
    available.sort(function (a, b) { return (b.installCount || 0) - (a.installCount || 0); });
  }

  // Skill and command names an available plugin ships, from the catalog cache
  function skillsOf(p) {
    var c = catalog[p.pluginId], out = [];
    if (!c || !c.components) return out;
    var lists = [c.components.skills || [], c.components.commands || []];
    for (var i = 0; i < lists.length; i++)
      for (var j = 0; j < lists[i].length; j++) out.push(lists[i][j].name || lists[i][j]);
    return out;
  }

  // Runs skills.ps1 hidden, then reloads the lists once it reports done.
  function runHelper(action, arg, onDone) {
    if (busy) return false;
    busy = true;
    var status = dataDir + "\\status.json";
    if (fso.FileExists(status)) fso.DeleteFile(status);
    shell.Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' +
      appDir + '\\skills.ps1" ' + action + (arg ? ' "' + arg + '"' : ''), 0, false);
    var timer = setInterval(function () {
      var s = readJson(status);
      if (!s || !s.done) return;
      clearInterval(timer);
      busy = false;
      loadData();
      if (onDone) onDone(s);
      render();
    }, 500);
    return true;
  }

  function setState(t) { $("state").innerHTML = t; }

  function openSkills() {
    $("home").style.display = "none";
    $("skills").style.display = "block";
    loadData();
    render();
    setState("Mise à jour…");
    runHelper("list", "", function () { setState(""); });
  }

  function closeSkills() {
    $("skills").style.display = "none";
    $("home").style.display = "block";
  }

  var searchTimer;
  function onSearch() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(render, 150);
  }

  function has(q, s) { return String(s || "").toLowerCase().indexOf(q) >= 0; }

  function repoFrom(q) {
    var m = q.match(/github\.com\/([\w.-]+\/[\w.-]+?)(\.git)?\/?$/i) || q.match(/^([\w.-]+\/[\w.-]+)$/);
    return m ? m[1] : null;
  }

  function toggle(key) {
    opened[key] = !opened[key];
    render();
  }

  function stop() { if (window.event) window.event.cancelBubble = true; }

  function installedItem(g, q) {
    var key = "i:" + g.plugin, skills = g.skills, auto = false;
    if (q && !has(q, g.plugin)) {
      skills = [];
      for (var i = 0; i < g.skills.length; i++)
        if (has(q, g.skills[i].name) || has(q, g.skills[i].description)) skills.push(g.skills[i]);
      if (!skills.length) return "";
      auto = true;
    }
    var isOpen = opened[key] === undefined ? auto : opened[key];
    var body = "";
    for (var j = 0; j < skills.length; j++) {
      var s = skills[j];
      body += '<div class="skill" title="' + esc(s.description) + '"><div class="sname">' + esc(s.name) +
        '</div><div class="cmd" onclick="copyCmd(\'' + esc(s.command) + '\')">' + esc(s.command) + '</div></div>';
    }
    if (!skills.length) body = '<div class="about">Aucun skill dans ce plugin.</div>';
    if (g.id) {
      body += '<div class="foot"><span class="link" onclick="uninstall(\'' + esc(g.id) + '\')">' +
        (confirmId === g.id ? "Confirmer la suppression" : "Désinstaller") + '</span></div>';
    }
    return '<div class="item' + (isOpen ? " open" : "") + '">' +
      '<div class="head" onclick="toggle(\'' + esc(key) + '\')"><div class="chev">&#8250;</div>' +
      '<div class="txt"><div class="name">' + esc(g.plugin) + '</div></div>' +
      '<div class="count">' + skills.length + '</div></div>' +
      '<div class="body">' + body + '</div></div>';
  }

  function availableItem(p) {
    var key = "a:" + p.pluginId, names = skillsOf(p), chips = "";
    for (var i = 0; i < names.length; i++) chips += '<span>' + esc(names[i]) + '</span>';
    var verified = isVerified(p.marketplaceName);
    var click = verified
      ? "install('" + esc(p.pluginId) + "')"
      : "askInstall('" + esc(p.pluginId) + "', '" + esc(p.name) + "')";
    var btn = pending === p.pluginId ? '<div class="btn busy">…</div>'
      : '<div class="btn' + (verified ? '' : ' caution') + '" onclick="stop(); ' + click + '">Installer</div>';
    var note = verified ? "" :
      '<div class="note">' + warnSvg(14) +
      '<div>Skill non vérifié — publié hors des marketplaces Anthropic. Son code s’exécute sur ta machine à tes risques.</div></div>';
    return '<div class="item' + (opened[key] ? " open" : "") + '">' +
      '<div class="head" onclick="toggle(\'' + esc(key) + '\')"><div class="chev">&#8250;</div>' +
      '<div class="txt"><div class="name">' + esc(p.name) + (verified ? '' : warnSvg(15)) +
      '</div><div class="desc">' + esc(p.description) + '</div></div>' +
      btn + '</div>' +
      '<div class="body">' + note + '<div class="about">' + esc(p.description) + '</div>' +
      (chips ? '<div class="chips">' + chips + '</div>' : '') + '</div></div>';
  }

  function render() {
    var raw = $("q").value.replace(/^\s+|\s+$/g, ""), q = raw.toLowerCase();
    var html = "", items = "";

    for (var i = 0; i < installed.length; i++) items += installedItem(installed[i], q);
    if (items) html += '<div class="section">Installés</div><div class="box">' + items + '</div>';

    // Plugins to install: search results, or the most popular ones
    items = "";
    var n = 0, max = q ? 30 : 8, seen = {};
    for (var k = 0; k < available.length && n < max; k++) {
      var p = available[k];
      if (installedIds[p.pluginId] || seen[p.name]) continue;
      if (q && !has(q, p.name) && !has(q, p.description) && !has(q, p.marketplaceName) && !has(q, skillsOf(p).join(" "))) continue;
      seen[p.name] = true;
      n++;
      items += availableItem(p);
    }
    var repo = repoFrom(raw);
    if (repo) {
      items = '<div class="item"><div class="head"><div class="chev"></div><div class="txt"><div class="name">' + esc(repo) +
        warnSvg(15) + '</div><div class="desc">Dépôt GitHub · non vérifié</div></div>' +
        '<div class="btn caution" onclick="askAddRepo(\'' + esc(repo) + '\')">Ajouter</div></div></div>' + items;
    }
    if (items) html += '<div class="section">' + (q ? "À installer" : "Populaires") + '</div><div class="box">' + items + '</div>';

    if (!html) html = '<div class="empty">Aucun résultat</div>';
    var list = $("list"), top = list.scrollTop;
    list.innerHTML = html;
    list.scrollTop = top;
  }

  function install(id) {
    if (busy) { toast("Patiente une seconde…"); return; }
    pending = id;
    setState("Installation…");
    render();
    runHelper("install", id, function (s) {
      pending = null;
      setState("");
      if (s.ok) opened["i:" + id.split("@")[0]] = true;
      toast(s.ok ? "Installé ✓  Relance Claude Code" : "Échec de l'installation");
    });
  }

  function uninstall(id) {
    if (confirmId !== id) { confirmId = id; render(); return; }
    if (busy) { toast("Patiente une seconde…"); return; }
    confirmId = null;
    setState("Suppression…");
    render();
    runHelper("uninstall", id, function (s) {
      setState("");
      toast(s.ok ? "Désinstallé" : "Échec de la suppression");
    });
  }

  function addRepo(repo) {
    if (busy) { toast("Patiente une seconde…"); return; }
    var before = {};
    for (var i = 0; i < available.length; i++) before[available[i].marketplaceName] = true;
    setState("Ajout du dépôt…");
    runHelper("add", repo, function (s) {
      setState("");
      if (s.ok) {
        // Show the plugins of the marketplace that just appeared
        for (var j = 0; j < available.length; j++)
          if (!before[available[j].marketplaceName]) { $("q").value = available[j].marketplaceName; break; }
        toast("Dépôt ajouté ✓");
      }
      else toast("Dépôt introuvable");
    });
  }

  function copyCmd(cmd) {
    stop();
    window.clipboardData.setData("Text", cmd);
    toast("Copié : " + cmd);
  }

  var toastTimer;
  function toast(t) {
    var el = $("toast");
    el.innerHTML = esc(t);
    el.style.display = "block";
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { el.style.display = "none"; }, 2400);
  }
</script>
<script src="greetings.js"></script>
<script src="robot.js"></script>
</body>
</html>
